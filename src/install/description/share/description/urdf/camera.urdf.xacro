<?xml version="1.0" ?>
<robot name="stand" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="my_pi" value="3.1415"/>
<xacro:property name="scale_small" value="0.001"/>
<xacro:property name="scale_large" value="0.01"/>
<xacro:property name="color_grey" value="0.6 0.6 0.6 1.0"/>
<xacro:property name="color_black" value="0.3 0.3 0.3 1.0"/>

<!-- Define a macro for a link with a visual and collision element -->
<xacro:macro name="add_link" params="name mesh scale color rpy xyz">
  <link name="${name}">
    <collision>
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <geometry>
        <mesh filename="package://description/meshes/${mesh}" scale="${scale} ${scale} ${scale}"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <geometry>
        <mesh filename="package://description/meshes/${mesh}" scale="${scale} ${scale} ${scale}"/>
      </geometry>
      <material name="Grey">
        <color rgba="${color}"/>
      </material>
    </visual>
  </link>
</xacro:macro>

<!-- Define a macro for a joint -->
<xacro:macro name="add_joint" params="name type parent child axis rpy xyz lower upper effort velocity">
  <joint name="${name}" type="${type}">
    <axis xyz="${axis}"/>
    <limit effort="${effort}" lower="${lower}" upper="${upper}" velocity="${velocity}"/>
    <origin rpy="${rpy}" xyz="${xyz}"/>
    <parent link="${parent}"/>
    <child link="${child}"/>
  </joint>
</xacro:macro>

<!-- Robot description -->

<link name="root_link"/>
<xacro:add_joint name="root_base_joint" type="fixed" parent="base" child="root_link" axis="0 0 0" rpy="0 0 0" xyz="0.0 0.0 0.5" lower="0" upper="0" effort="0" velocity="0"/>
<link name="base"/>

<xacro:add_link name="box" mesh="box.stl" scale="${scale_small}" color="${color_black}" rpy="0 1.57 0" xyz="0 0 0"/>
<xacro:add_joint name="box_trc_211_joint" type="fixed" parent="root_link" child="box" axis="0 0 0" rpy="1.57 0 0" xyz="-0.162 0.505 0.205" lower="0" upper="0" effort="0" velocity="0"/>

<!--==========================-->
<!-- SENSORS -->
<!--==========================-->

<link name="camera"/>
<xacro:add_joint name="camera_joint" type="fixed" parent="box" child="camera" axis="0 0 0" rpy="-0.20944 -1.57 3.14" xyz="0.19489 0.049 0.1725" lower="0" upper="0" effort="0" velocity="0"/>

</robot>

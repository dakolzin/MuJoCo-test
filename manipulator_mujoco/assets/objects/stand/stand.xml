<!-- stand.xml -->

<mujoco model="stand">
  <compiler meshdir="assets" />
  <visual>
    <global azimuth="90" elevation="-90"/>
  </visual>
  <default>
    <default class="stand">
      <material specular="0.3" shininess="0.8"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" solref="0.02 1" solimp="0.95 0.99 0.001"/>
      </default>
    </default>
  </default>
  <asset>
    <material name="stand_material" rgba="0.8 0.8 0.8 1"/>
    <mesh name="stand_mesh" file="stand.obj" scale="1 1 1"/>
  </asset>
  <worldbody>
    <body name="stand_body" childclass="stand" pos="0 0 0">
      <inertial pos="0 0 0" mass="100" diaginertia="0.01 0.01 0.01"/>
      <geom mesh="stand_mesh" material="stand_material" class="visual"/>
      <geom mesh="stand_mesh" material="stand_material" class="collision"/>
    </body>
  </worldbody>
</mujoco>

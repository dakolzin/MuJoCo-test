<!-- desk.xml -->

<mujoco model="desk">
  <compiler meshdir="assets" />
  <visual>
    <global azimuth="90" elevation="-90"/>
  </visual>
  <default>
    <default class="desk">
      <material specular="0.3" shininess="0.8"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" solref="0.02 1" solimp="0.95 0.99 0.001"/>
      </default>
    </default>
  </default>
  <asset>
    <material name="desk_material" rgba="0.8 0.8 0.8 1"/>
    <mesh name="desk_mesh" file="desk.obj" scale="1 1 1"/>
  </asset>
  <worldbody>
    <body name="desk_body" childclass="desk" pos="0 0 0">
      <inertial pos="0 0 0" mass="30" diaginertia="0.01 0.01 0.01"/>
      <geom mesh="desk_mesh" material="desk_material" class="visual"/>
      <!--geom mesh="desk_mesh" material="desk_material" class="collision"/-->
    </body>
  </worldbody>
</mujoco>
